{
  "name": "enzyme-fund-paper-control",
  "version": "1.0.0",
  "description": "Offline paper-only fund governance and evidence boundary",
  "private": true,
  "license": "UNLICENSED",
  "main": "./build/governance/index.js",
  "types": "./build/governance/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "clean": "node scripts/clean-build.cjs",
    "build": "yarn clean && tsc -p tsconfig.json",
    "verify:boundary": "node scripts/check-boundary.cjs && node scripts/check-provenance.cjs",
    "test": "yarn build && node --test test/*.test.cjs",
    "start": "yarn build && node scripts/paper-demo.cjs",
    "legacy:build": "node scripts/refuse-legacy.cjs",
    "prepublishOnly": "node scripts/refuse-publish.cjs"
  },
  "devDependencies": {
    "@types/node": "20.19.24",
    "typescript": "5.9.3"
  }
}
